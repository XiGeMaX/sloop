# HTTP port used by the container and local development server.
PORT=2167

# SQLite database and the self-hosted static frontend.
SLOOP_DATABASE_PATH=./data/sloop.db
SLOOP_STATIC_DIR=./public

# Optional explicit HMAC key. Leave empty to generate a durable key file.
LINK_SIGNING_SECRET=
SLOOP_SECRET_FILE=./data/signing-secret

# IANA time zone used when a plan does not specify one.
DEFAULT_TIMEZONE=Asia/Shanghai
