{
  "name": "sloop",
  "version": "1.0.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "scripts": {
    "build": "esbuild public/app.js --bundle --format=esm --outfile=public/app.bundle.js",
    "predev": "pnpm build",
    "dev": "go run ./cmd/sloop",
    "start": "go run ./cmd/sloop",
    "admin": "go run ./cmd/sloop-admin",
    "admin:reset": "go run ./cmd/sloop-admin",
    "test": "go test ./... && node --test test/*.test.mjs",
    "test:go": "go test ./...",
    "test:frontend": "node --test test/*.test.mjs",
    "format:check": "test -z \"$(gofmt -l cmd internal migrations)\"",
    "check": "pnpm format:check && go vet ./... && go test ./... && pnpm test:frontend && node --check public/app.js && node --check public/i18n.js && node --check public/theme-init.js && pnpm build"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "esbuild": "^0.28.2"
  },
  "dependencies": {
    "i18next": "^26.4.7"
  }
}
