{
  "name": "sloop",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "esbuild public/app.js --bundle --format=esm --outfile=public/app.bundle.js",
    "predev": "pnpm build",
    "dev": "wrangler dev",
    "predeploy": "pnpm build",
    "deploy": "wrangler deploy",
    "admin:reset": "node scripts/reset-admin-password.mjs",
    "test": "node --test",
    "check": "node --check worker.js && node --check public/app.js && node --check public/i18n.js && pnpm build"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "esbuild": "^0.28.2",
    "wrangler": "^4.151.1"
  },
  "dependencies": {
    "i18next": "^26.4.7"
  }
}
