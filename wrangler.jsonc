{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "sloop",
  "main": "worker.js",
  "compatibility_date": "2026-10-18",
  "workers_dev": true,
  "preview_urls": false,
  "assets": {
    "directory": "./public",
    "binding": "ASSETS"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "sloop-db",
      "database_id": "8b000c83-1702-43f0-8084-e7b19dfeb8f8",
      "migrations_dir": "migrations"
    }
  ],
  "vars": {
    "APP_ENV": "production",
    "DEFAULT_TIMEZONE": "Asia/Shanghai"
  },
  "triggers": {
    "crons": ["17 3 * * *"]
  }
}
